# =============================================================================
# Living Room AI - environment template
# Copy to .env and fill in real values.  .env is git-ignored.
#     cp .env.example .env
# =============================================================================

# ---- Kaggle (workshop / data ingestion only) --------------------------------
# export KAGGLE_API_TOKEN in your shell; do NOT commit it. See workshop/README.md.
KAGGLE_API_TOKEN=

# ---- Hugging Face (optional; only needed for gated repos) --------------------
HF_TOKEN=
HF_HOME=/hf_cache

# ---- MinIO object storage ---------------------------------------------------
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=password123
MINIO_ENDPOINT=minio:9000
MINIO_SECURE=false
MINIO_BUCKET_DATA=interior-design-data
MINIO_BUCKET_IMAGES=generated-images
MINIO_BUCKET_MODELS=models

# ---- PostgreSQL (SQLAlchemy) ------------------------------------------------
POSTGRES_USER=livingroom
POSTGRES_PASSWORD=livingroom_pw
POSTGRES_DB=livingroom
DATABASE_URL=postgresql+psycopg2://livingroom:livingroom_pw@postgres:5432/livingroom

# ---- Service URLs (internal docker network) ---------------------------------
AI_SERVICE_URL=http://ai-service:8100
LLM_SERVICE_URL=http://llm-service:8200
CAPTION_SERVICE_URL=http://caption-service:8300

# ---- Prompt enhancement -----------------------------------------------------
# "llm"   -> use the Qwen llm-service (with rule-based fallback on failure)
# "local" -> rule-based enhancement only (no LLM call)
PROMPT_ENHANCER=llm
MAX_PROMPT_LENGTH=1000

# ---- Model ids --------------------------------------------------------------
SDXL_MODEL_ID=stabilityai/stable-diffusion-xl-base-1.0
SDXL_VAE_ID=madebyollin/sdxl-vae-fp16-fix
LLM_MODEL_ID=Qwen/Qwen2.5-1.5B-Instruct
BLIP_MODEL_ID=Salesforce/blip-image-captioning-large

# ---- LoRA -------------------------------------------------------------------
LORA_NAME=living-room-style-v1
LORA_OBJECT_KEY=models/living-room-style-v1/pytorch_lora_weights.safetensors
LORA_SCALE=0.8
LORA_AUTOLOAD=true

# ---- Generation defaults ----------------------------------------------------
DEFAULT_WIDTH=1024
DEFAULT_HEIGHT=1024
DEFAULT_STEPS=30
DEFAULT_GUIDANCE_SCALE=7.5

# ---- Workshop / LoRA training knobs -----------------------------------------
TRAIN_RESOLUTION=1024
MAX_TRAIN_STEPS=1000
LORA_RANK=16

# ---- Host port publishing (docker-compose) ----------------------------------
FRONTEND_HOST_PORT=8080
BACKEND_HOST_PORT=8000
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
