# =========================================================================
#  AI Living Room Generator — environment template
#  Copy to .env and fill in. .env is git-ignored (never commit secrets).
#      cp .env.example .env
# =========================================================================

# ---- MinIO object storage ----
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=change-me-please-123
MINIO_ENDPOINT=minio:9000
MINIO_SECURE=false
MINIO_BUCKET_GENERATED=generated-images
MINIO_BUCKET_MODELS=models
MINIO_BUCKET_DATASET=interior-design-data

# ---- Backend ----
# SQLite lives on a mounted volume by default (see docker-compose).
DATABASE_URL=sqlite:////data/app.db
BACKEND_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
AI_SERVICE_URL=http://ai-service:8100
# Max characters allowed in a raw user prompt (validation).
MAX_PROMPT_LENGTH=1000

# ---- Prompt enhancement (LLM) ----
# Enhancer backend: "groq" (cloud) or "local" (rule-based, no API key needed).
# If "groq" is selected but no key is set, the system falls back to "local".
PROMPT_ENHANCER=groq
GROQ_API_KEY=
GROQ_MODEL=qwen-2.5-32b

# ---- AI service (SDXL) ----
SDXL_MODEL_ID=stabilityai/stable-diffusion-xl-base-1.0
# Object name of the LoRA weights inside the MODELS bucket. Leave blank for base SDXL.
LORA_OBJECT=living-room-style-v1/pytorch_lora_weights.safetensors
LORA_SCALE=0.8
# "cuda" or "cpu". Use "cpu" only for smoke tests (extremely slow).
AI_DEVICE=cuda
# Cap on generation to protect VRAM / latency.
MAX_STEPS=60
MAX_SIDE=1536
HF_HOME=/models/hf_cache

# ---- Training pipeline (host-side, not part of docker-compose) ----
# Kaggle API token — set in your shell, do NOT commit. See training/README.md.
# export KAGGLE_API_TOKEN=...
